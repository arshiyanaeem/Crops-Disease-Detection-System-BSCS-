<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AgriExpertSystem</RootNamespace>
    <StartupObject>AgriExpertSystem.Program</StartupObject>
    <Nullable>disable</Nullable>
    <AssemblyTitle>AXPERT Mini - Crop Disease Expert System</AssemblyTitle>
    <Description>Mini agriculture expert system for Rice, Wheat and Sugarcane leaf disease detection</Description>
  </PropertyGroup>

</Project>
